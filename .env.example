# ============================================================
# 毛团子AI · 环境变量模板
# 复制为 .env.local 并填写真实值
# ============================================================

# 运行环境
NODE_ENV=development
SPRING_PROFILES_ACTIVE=dev

# 后端服务
PORT=8080

# JWT（生产环境 ≥ 32 字符随机，使用 KMS 注入）
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters

# 数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_with_local_database_password
DB_NAME=maotuanzi

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# 微信生态
WECHAT_APP_ID=replace_with_local_app_id
WECHAT_APP_SECRET=replace_with_local_app_secret
WECHAT_PAY_MCH_ID=replace_with_local_merchant_id
WECHAT_PAY_API_KEY=replace_with_local_32_char_key

# 阿里云 OSS
OSS_ENABLED=false
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=maotuanzi-dev
OSS_ACCESS_KEY_ID=replace_with_local_access_key_id
OSS_ACCESS_KEY_SECRET=replace_with_local_access_key_secret
OSS_CDN_DOMAIN=

# AI 服务商（待实测选型）
AI_ENABLED=false
AI_MOCK_MODE=true
DOUBAO_API_KEY=
DASHSCOPE_API_KEY=
TRIPO_API_KEY=

# 监控
SENTRY_DSN=
MAOTUANZI_PAYMENT_WECHAT_PLATFORM_PUBLIC_KEY_PATH=
MAOTUANZI_PAYMENT_WECHAT_PLATFORM_SERIAL_NO=
