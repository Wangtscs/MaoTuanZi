<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.maotuanzi.mapper.RewardMapper">

    <resultMap id="BaseResultMap" type="com.maotuanzi.entity.Reward">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="type" property="type"/>
        <result column="value" property="value"/>
        <result column="ref_type" property="refType"/>
        <result column="ref_id" property="refId"/>
        <result column="status" property="status"/>
        <result column="remark" property="remark"/>
        <result column="expire_at" property="expireAt"/>
        <result column="claimed_at" property="claimedAt"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <insert id="insert" parameterType="com.maotuanzi.entity.Reward" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO rewards (user_id, type, `value`, ref_type, ref_id, status, remark, expire_at)
        VALUES (#{userId}, #{type}, #{value}, #{refType}, #{refId}, #{status}, #{remark}, #{expireAt})
    </insert>

    <update id="updateClaimed" parameterType="com.maotuanzi.entity.Reward">
        UPDATE rewards SET status = #{status}, claimed_at = #{claimedAt} WHERE id = #{id}
    </update>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM rewards WHERE id = #{id}
    </select>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT * FROM rewards WHERE user_id = #{userId}
        <if test="status != null">AND status = #{status}</if>
        ORDER BY id DESC
    </select>

    <select id="selectPendingShareToday" resultMap="BaseResultMap">
        SELECT * FROM rewards
        WHERE user_id = #{userId} AND ref_type = 'SHARE' AND status = 0 AND DATE(created_at) = #{day}
        LIMIT 1
    </select>

</mapper>
