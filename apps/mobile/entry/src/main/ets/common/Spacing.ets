/**
 * 间距系统（基于 vp）
 */
export class Spacing {
  static readonly XS: number = 4;        // 8rpx
  static readonly S: number = 8;         // 16rpx
  static readonly M: number = 12;        // 24rpx
  static readonly L: number = 16;        // 32rpx
  static readonly XL: number = 24;       // 48rpx
  static readonly XXL: number = 32;      // 64rpx
}